# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"

# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="SEU_CLOUD_NAME_AQUI"
# NEXT_PUBLIC_CLOUDINARY_API_KEY="SUA_API_KEY_AQUI"
# CLOUDINARY_API_SECRET="SEU_API_SECRET_AQUI"

# Monitoramento ESP32 (opcionais; estes são os valores padrão)
MQTT_URL="mqtt://broker.hivemq.com:1883"
MQTT_PIR_TOPIC="salas/b10/movimento"
# MQTT_USERNAME=""
# MQTT_PASSWORD=""

# Recebimento do sketch original (independente do coletor de reservas).
ESP32_MQTT_URL="mqtt://broker.hivemq.com:1883"
ESP32_MQTT_TOPIC="salas/b10/movimento"
# Ativar somente após migrar o ESP32: painel usa MQTT_URL e credenciais do coletor via TLS.
ESP32_MQTT_USE_COLLECTOR="false"

# Liberação automática exige broker privado autenticado com mqtts:// ou wss://.
IOT_ALLOW_AUTOMATIC_RELEASE="false"
# Remetente verificado no Resend. Sem configuração, os avisos ficam no sistema.
# IOT_EMAIL_FROM="Nexo <reservas@seu-dominio.com>"
# RESEND_API_KEY=""
