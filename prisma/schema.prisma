generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelos da Aplicação

model User {
  id        String   @id @default(cuid()) // CUID é um ID único e seguro para colisões
  name      String
  email     String   @unique
  password  String
  role      Role     @default(TEACHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings      Booking[]        @relation("BookingUser")
  requestedBookings Booking[]    @relation("BookingRequester")
  auditLogs     AuditLog[]
  requests      BookingRequest[] @relation("BookingRequestUser")
  requestedRequests BookingRequest[] @relation("BookingRequestRequester")
  notifications Notification[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String 
  details   String 
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model BookingRequest {
  id        String   @id @default(cuid())
  roomId    String
  classCode String
  timeSlots String[]
  startDate DateTime
  endDate   DateTime
  weekdays  Int[]
  status    String   @default("PENDENTE")
  refusalReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation("BookingRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  requester   User?   @relation("BookingRequestRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  requesterId String?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Room {
  id        String   @id @default(cuid())
  name      String
  location  String? // O '?' torna o campo opcional
  capacity  Int
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[] // Uma sala pode ter várias reservas
  resources Resource[]
  images    RoomImage[]
  requests  BookingRequest[]
  iotConfig RoomIotConfig?
}

model Resource {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms Room[]
}

model RoomImage {
  id        String   @id @default(cuid())
  url       String   @db.Text
  createdAt DateTime @default(now())

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
}

model Booking {
  id        String        @id @default(cuid())
  title     String
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  period    Period        @default(MANHA)
  attendance AttendanceStatus @default(WAITING)
  verifiedAt DateTime?
  verificationSource String?
  warnedAt DateTime?
  confirmationDeadline DateTime?
  releasedAt DateTime?
  releaseReason String?
  attendanceEvents AttendanceEvent[]


  classCode      String? // Código da turma (opcional para reservas únicas)
  bookingGroupId String? // ID para agrupar reservas da mesma turma

  // Chaves estrangeiras e Relações
  userId String
  user   User   @relation("BookingUser", fields: [userId], references: [id], onDelete: Cascade)

  requesterId String?
  requester   User?   @relation("BookingRequester", fields: [requesterId], references: [id], onDelete: SetNull)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
  @@index([bookingGroupId]) // Adicionar um índice para facilitar a busca por grupo
}

enum Role {
  TEACHER
  MANAGER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  PENDING
  CANCELLED
  NO_SHOW
}

enum AttendanceStatus {
  WAITING
  VERIFIED
  SUSPECTED_NO_SHOW
  INCONCLUSIVE
}

enum IotMode {
  OFF
  OBSERVE
  AUTOMATIC
}

model RoomIotConfig {
  id String @id @default(cuid())
  roomId String @unique
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  deviceId String @unique
  topic String @unique
  mode IotMode @default(OBSERVE)
  warningMinutes Int @default(10)
  releaseMinutes Int @default(20)
  heartbeatSeconds Int @default(90)
  lastSeenAt DateTime?
  healthySince DateTime?
  lastMotionAt DateTime?
  bootId String?
  lastSequence Int @default(-1)
  ready Boolean @default(false)
  updatedAt DateTime @updatedAt
  telemetry IotTelemetry[]
}

model IotTelemetry {
  id String @id @default(cuid())
  configId String
  config RoomIotConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  bootId String
  sequence Int
  receivedAt DateTime @default(now())
  motion Boolean
  ready Boolean
  @@unique([configId, bootId, sequence])
  @@index([configId, receivedAt])
}

model AttendanceEvent {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind String
  detail String
  actorId String?
  createdAt DateTime @default(now())
  @@index([bookingId, createdAt])
}

model IotRuntime {
  id String @id
  owner String
  leaseUntil DateTime
  lastTickAt DateTime
  connected Boolean @default(false)
  error String?
}

model IotEmail {
  id String @id @default(cuid())
  dedupeKey String @unique
  to String
  subject String
  text String
  createdAt DateTime @default(now())
  expiresAt DateTime
  sentAt DateTime?
  nextAttemptAt DateTime @default(now())
  attempts Int @default(0)
  error String?
}

enum Period {
  MANHA
  TARDE
  NOITE
}
